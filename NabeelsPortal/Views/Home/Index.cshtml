@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Agri-Energy Connect Platform</h1>
    <p>Our platform connects farmers and employees to streamline the management of agricultural products and resources.</p>
    <p>Farmers can easily add and manage their products, while employees can oversee and filter product listings.</p>

    <h2>Key Features</h2>
    <ul class="text-center">
        <li>Farmers can add new products and view their listings.</li>
        <li>Employees can add farmer profiles, view, and filter products.</li>
    </ul>

    <h2 class="mb-5">Please Click On The Button Below To Login</h2>
    <a href="/Account/Login" class="btn btn-primary btn-lg">Login</a>
</div>
