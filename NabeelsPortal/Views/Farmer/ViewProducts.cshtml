@model List<NabeelsPortal.Models.Product>

@{
    ViewData["Title"] = "View Products";
}

<div class="container">
    <h2 class="mb-4">Your Products</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Production Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductName</td>
                    <td>@product.Category</td>
                    <td>@product.ProductionDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="mt-3 d-flex justify-content-center mt-5">
        <a href="/Farmer" class="btn btn-primary btn-lg mx-4">Back to Dashboard</a>
        <a href="/Farmer/AddProduct" class="btn btn-primary btn-lg">Add Another Product</a>
    </div>
</div>
