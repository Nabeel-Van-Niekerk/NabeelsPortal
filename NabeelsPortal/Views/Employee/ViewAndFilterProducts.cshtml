@model NabeelsPortal.DTO.ViewProducts

@{

    var farmerId = ViewBag.FarmerId as string;
    var farmer = Model.Farmers.FirstOrDefault(f => f.FarmerId == farmerId);
    var farmerName = farmer?.Name ?? "Unknown Farmer";

    // Define default dates
    var today = DateTime.Now.ToString("yyyy-MM-dd");

    // Ensure correct date handling
    var startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "";
    var endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "";

    var productTypes = Model.ProductTypes;
    var selectedProductType = Model.ProductType;

    // Generate options for product types
    string GetOptionsHtml()
    {
        var options = new System.Text.StringBuilder();
        options.Append("<option value=\"\">All</option>");

        foreach (var type in productTypes)
        {
            var selected = type == selectedProductType ? "selected" : "";
            options.AppendFormat("<option value=\"{0}\" {1}>{2}</option>", type, selected, type);
        }

        return options.ToString();
    }
}

<h1>Products for @farmerName</h1>

<form method="get" action="@Url.Action("ViewProducts", "Employee")" class="form-inline mb-3">
    <input type="hidden" name="farmerId" value="@ViewBag.FarmerId" />
    <div class="form-group mr-2">
        <label for="startDate" class="mr-2">Start Date:</label>
        <input type="date" id="startDate" name="startDate" class="form-control" value="@startDate" placeholder="YYYY-MM-DD" />
    </div>
    <div class="form-group mr-2">
        <label for="endDate" class="mr-2">End Date:</label>
        <input type="date" id="endDate" name="endDate" class="form-control" value="@endDate" placeholder="YYYY-MM-DD" />
    </div>
    <div class="form-group mr-2">
        <label for="productType" class="mr-2">Product Type:</label>
        <select id="productType" name="productType" class="form-control">
            @Html.Raw(GetOptionsHtml())
        </select>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary btn-lg mx-4">Filter</button>
        <a href="@Url.Action("ViewProducts", "Employee", new { farmerId = ViewBag.FarmerId })" class="btn btn-secondary btn-lg">Reset</a> <!-- Reset Button -->
    </div>
</form>

@if (Model.Products.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Category</th>
                <th>Production Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.ProductName</td>
                    <td>@product.Category</td>
                    <td>@product.ProductionDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products found.</p>
}

<div class="mt-3 d-flex justify-content-center">
    <a href="/Employee/ViewFarmers" class="btn btn-primary mx-5 btn-lg">View All Farmers</a>
    <a href="/Employee" class="btn btn-primary btn-lg">Back to Dashboard</a>
</div>
