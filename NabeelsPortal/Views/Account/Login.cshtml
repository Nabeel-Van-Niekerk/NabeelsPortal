@model NabeelsPortal.DTO.Login

@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <h2 class="text-center mb-4">Login</h2>
    <form asp-action="Login" method="post" class="form-horizontal">
        <div class="form-group mb-3">
            <label asp-for="EmailOrUsername" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="EmailOrUsername" class="form-control" />
                <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group mt-4">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary btn-lg">Login</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
